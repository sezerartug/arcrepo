{
  "name": "arc-global",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "secretlint --maskSecrets \"**/*\"",
    "test:unit": "pnpm -r test:unit",
    "test:int": "pnpm -r test:int",
    "db:start": "pnpm --filter @arc/api db:start",
    "seed": "pnpm --filter @arc/api seed",
    "demo": "pnpm db:start && pnpm seed && pnpm dev",
    "db:stop": "pnpm --filter @arc/api db:stop"
  },
  "devDependencies": {
    "@arc/config": "workspace:*",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.0"
  }
}
