    "db:stop": "tsx scripts/dev-db.ts stop"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "kysely": "0.28.18",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@arc/config": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
