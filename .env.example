# Copy to .env for local development. Never commit .env; never put production values here.
# compose.yaml and apps/api both read the repo-root .env.

# --- API (validated at startup: apps/api/src/modules/platform/infrastructure/env.ts)
NODE_ENV=development
PORT=3001

# --- Local services (compose.yaml)
POSTGRES_USER=arc
POSTGRES_PASSWORD=arc_dev
POSTGRES_DB=arc
POSTGRES_PORT=5432
REDIS_PORT=6379
